        <mxCell id="leg_rel_desc" value="العلاقة (Relationship):&#xa;الرابط المنطقي الذي يربط بين كيانين أو أكثر&#xa;بنسب تعددية: (1 إلى 1، أو 1 إلى متعدد 1:N)." style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontFamily=Arial;fontColor=#334155;" parent="1" vertex="1">
